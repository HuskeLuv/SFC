// Auditoria de asset_dividend_history (só leitura na origem). Reescrita por símbolo.
model AssetProventoAuditado {
  id                String    @id @default(uuid())
  // asset_dividend_history.id
  origemId          String    @unique
  symbol            String
  // BRAPI | YAHOO
  source            String
  tipoOriginal      String
  // DIVIDENDO | JCP | RENDIMENTO | AMORTIZACAO | REST_CAP | OUTRO
  tipoNormalizado   String
  // por ação/cota, como declarado (bruto)
  valor             Float
  // YAHOO não tem (a coluna date dele é a data EX)
  dataPagamento     DateTime? @db.Date
  // o que o app chama de dataCom
  dataExGravada     DateTime? @db.Date
  // pregão B3 anterior à data ex
  dataComReal       DateTime? @db.Date
  // 'dataCom' (BRAPI) | 'date' (YAHOO)
  dataExOrigem      String?
  // valido | duplicata | tipo_excluido | sem_data_com | fonte_secundaria_descartada
  status            String
  duplicataDe       String?
  // Π eventos confirmados com data > dataComReal
  fatorAjusteHoje   Float
  valorAjustadoHoje Float
  flags             String[]
  auditadoEm        DateTime

  @@index([symbol, dataComReal])
  @@index([symbol, status])
  @@map("asset_proventos_auditados")
}

