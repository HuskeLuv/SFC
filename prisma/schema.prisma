// Só a maior versão por (cnpj, mês); só CNPJs de FiiTickerMap (universo B3).
model FiiMonthly {
  id                 String    @id @default(uuid())
  cnpj               String
  // 1º dia do mês
  refMonth           DateTime  @db.Date
  versao             Int
  dtEntrega          DateTime? @db.Date
  // recomputado se ≠ PL/cotas >1% (regra 22)
  vpCota             Decimal?  @db.Decimal(18, 8)
  vpCotaRecalculado  Boolean   @default(false)
  pl                 Decimal?  @db.Decimal(20, 2)
  cotas              Decimal?  @db.Decimal(20, 4)
  cotistas           Int?
  // SÓ checagem, nunca exibido (regra 21)
  dyMesCvmPct        Float?
  rentEfetivaMesPct  Float?
  taxaAdmPct         Float?
  ativoTotal         Decimal?  @db.Decimal(20, 2)
  passivoTotal       Decimal?  @db.Decimal(20, 2)
  rendDistribuir     Decimal?  @db.Decimal(20, 2)
  obrigAquisicao     Decimal?  @db.Decimal(20, 2)
  obrigSecuritizacao Decimal?  @db.Decimal(20, 2)
  // Direitos_Bens_Imoveis
  imoveis            Decimal?  @db.Decimal(20, 2)
  spe                Decimal?  @db.Decimal(20, 2)
  // CRI + CRI_CRA
  cri                Decimal?  @db.Decimal(20, 2)
  // LCI + LCI_LCA + LH + LIG (caixa, não recebível)
  lciLca             Decimal?  @db.Decimal(20, 2)
  cotasFii           Decimal?  @db.Decimal(20, 2)
  rendaFixa          Decimal?  @db.Decimal(20, 2)
  acoes              Decimal?  @db.Decimal(20, 2)
  segmentoCvm        String?
  // tijolo | papel | fof | hibrido | indefinido
  tipoComposicao     String?
  // após histerese e override
  tipoVigente        String?
  // fii_tijolo | fii_papel | fora_do_indice
  reguaVigente       String?
  // (passivoTotal − rendDistribuir) ÷ PL × 100 (decisão 7, 'Obrigações/PL')
  obrigacoesPlPct    Float?
  // cotas ×≥5 no mês (regra 22)
  fatorDesdobramento Float?
  flags              String[]
  sourceUrl          String
  fetchedAt          DateTime

  @@unique([cnpj, refMonth])
  @@index([refMonth])
  @@map("fii_monthly")
}

