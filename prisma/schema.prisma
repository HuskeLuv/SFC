// ===========================================================================
// Análise de Ativos — Fase 1 (Quadro + Página do ativo). Tudo aditivo.
// ===========================================================================

/**
 * Linha pré-calculada do Quadro (uma por ticker de ação/FII do cadastro), gravada pelo job
 * 'quadro' (fatia A). Os leitores (src/services/analiseAtivos/leitura/linhasQuadro.ts) guardam
 * as ~800 linhas em memória por versão (= max(geradoEm)). Séries só com anos FECHADOS.
 */
model AnaliseQuadroLinha {
  symbol                String    @id
  // acao | fii
  classe                String
  cnpj                  String
  dataRef               DateTime  @db.Date
  // negociadoUltimos30 && !fiagro
  noQuadro              Boolean
  // sem_negociacao_30 | fiagro
  foraDoQuadroMotivo    String?
  temScore              Boolean
  // calculado | incompleto | zero_regra | fora_do_indice | sem_score
  estadoIndice          String
  nome                  String
  nomeCurto             String?
  setor                 String?
  subsetor              String?
  segmento              String?
  segmentoListagem      String?
  fiiTipo               String?
  segmentoCvm           String?
  regua                 String?
  tickerReferencia      String?
  preco                 Decimal?  @db.Decimal(18, 6)
  precoData             DateTime? @db.Date
  variacaoDiaPct        Float?
  volumeMedio21         Decimal?  @db.Decimal(20, 2)
  baixaLiquidez         Boolean   @default(false)
  valorMercado          Decimal?  @db.Decimal(22, 2)
  patrimonio            Decimal?  @db.Decimal(20, 2)
  indiceMf              Float?
  criteriosAtendidos    Int?
  criteriosAplicaveis   Int?
  statusCriterios       String[]
  motivosIncompleto     String[]
  // ex.: ['lucro:prejuizo','preco:pl_negativo']
  componentesZeroRegra  String[]
  anosLucroConsecutivos Int?
  mesesComRendimento    Int?
  anosDividendo         Int?
  roePct                Float?
  pl                    Float?
  pvp                   Float?
  dy12mPct              Float?
  margemLiquidaPct      Float?
  divLiqEbitda          Float?
  divLiqPl              Float?
  payoutPct             Float?
  vacanciaFisicaCvmPct  Float?
  nImoveisCvm           Int?
  nCri                  Int?
  obrigacoesPlPct       Float?
  cotistas              Int?
  naoSeAplica           String[]
  // [{ano, valor|null, suspeito?}] só anos fechados
  serie10a              Json
  serieUlt12m           Float?
  pares                 String[]
  // sem FK (Asset pode não existir para o ticker)
  assetId               String?
  // inclui provento_suspeito, proventos_defasados
  flags                 String[]
  paramsVersion         Int?
  geradoEm              DateTime

  @@index([classe, noQuadro])
  @@index([geradoEm])
  @@map("analise_quadro_linhas")
}

/**
 * Tese PRIVADA do usuário sobre um ativo (uma por usuário e ticker; ≤ 10.000 caracteres, zod).
 */
model AnaliseTese {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("AnaliseTeseUser", fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  corpo        String   @db.Text
  // Fase 1: só 'privada'
  visibilidade String   @default("privada")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, updatedAt])
  @@map("analise_teses")
}

/**
 * Lista de beta por recurso (ex.: 'analise-ativos'), operada por script. Admins entram sem estar aqui.
 */
model FeatureBetaUser {
  id            String   @id @default(uuid())
  // 'analise-ativos'
  recurso       String
  userId        String
  user          User     @relation("FeatureBetaUserUser", fields: [userId], references: [id], onDelete: Cascade)
  adicionadoPor String
  motivo        String?
  createdAt     DateTime @default(now())

  @@unique([recurso, userId])
  @@index([userId])
  @@map("feature_beta_users")
}

// ---------------------------------------------------------------------------------------------
// Análise de Ativos — bloco C (relatar dado incorreto + curadoria). Migration aditiva
// 20261010000000_analise_ativos_bloco_c. Contratos: src/services/analiseAtivos/curadoria/contrato.ts
// e src/services/analiseAtivos/regras/comum/conferencia.ts.
// ---------------------------------------------------------------------------------------------

/**
 * Caso de curadoria = ativo × dado (symbol, campo, período). Junta relatos de usuários e detecções
 * das regras de sanidade numa fila só (/admin/curadoria).
 */
model AnaliseCasoDado {
  id                String              @id @default(uuid())
  symbol            String
  cnpj              String?
  // acao | fii
  classe            String
  // GrupoConferencia | 'outro'
  grupo             String
  campo             String
  periodo           String?
  // usuario | regra | misto
  origem            String
  regraCodigo       String?
  chaveDeteccao     String?
  // chaveCaso(); null ao fechar (permite novo caso para o mesmo dado depois)
  chaveAberta       String?             @unique
  // aberto | em_analise | corrigido | rejeitado
  status            String              @default("aberto")
  resolucao         String?
  // manter_conferencia | liberar_valor | sem_efeito
  efeitoTela        String?
  // regra bloqueante ativa no último run
  emConferencia     Boolean             @default(false)
  regraAtiva        Boolean             @default(false)
  // reservado (decisão 16: sem conferência manual nesta fase; fica sempre false)
  conferenciaManual Boolean             @default(false)
  // 5 dias úteis (calendário B3) desde o 1º relato; null = caso só de regra (sem prazo)
  slaAte            DateTime?           @db.Date
  responsavelId     String?
  responsavel       User?               @relation("AnaliseCasoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  notaCurador       String?             @db.Text
  respostaPublica   String?             @db.VarChar(500)
  contexto          Json
  nReportes         Int                 @default(0)
  casoAnteriorId    String?
  abertoEm          DateTime            @default(now())
  ultimaDeteccaoEm  DateTime?
  resolvidoEm       DateTime?
  resolvidoPorId    String?
  updatedAt         DateTime            @updatedAt
  reportes          AnaliseDataReport[]
  eventos           AnaliseCasoEvento[]

  @@index([status, slaAte])
  @@index([symbol, status])
  @@index([origem, status])
  @@index([regraCodigo, chaveDeteccao])
  @@index([conferenciaManual, status])
  @@map("analise_casos_dado")
}

/**
 * Relato de dado incorreto feito por um usuário, com o contexto exibido na tela e o snapshot do
 * servidor. Texto livre (mensagem, valorEsperado, fonteEsperada) é anonimizado na exclusão de conta
 * e 12 meses após o fechamento do caso (anonimizadoEm).
 */
model AnaliseDataReport {
  id               String          @id @default(uuid())
  protocolo        String          @unique @db.VarChar(12)
  casoId           String
  caso             AnaliseCasoDado @relation(fields: [casoId], references: [id], onDelete: Cascade)
  // autor logado (o consultor, quando age pelo cliente)
  userId           String
  user             User            @relation("AnaliseReporteAutor", fields: [userId], references: [id], onDelete: Cascade)
  clienteId        String?
  cliente          User?           @relation("AnaliseReporteCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  symbol           String
  bloco            String
  campo            String
  periodo          String?         @db.VarChar(32)
  valorExibido     String?         @db.VarChar(64)
  valorEsperado    String?         @db.VarChar(64)
  fonteExibida     String?         @db.VarChar(160)
  frescorExibido   String?         @db.VarChar(160)
  versaoQuadro     String          @db.VarChar(40)
  mensagem         String          @db.VarChar(1000)
  fonteEsperada    String?         @db.VarChar(300)
  contextoServidor Json
  respondidoEm     DateTime?
  anonimizadoEm    DateTime?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([symbol, createdAt])
  @@index([casoId])
  @@index([createdAt])
  @@map("analise_data_reports")
}

/**
 * Auditoria do caso (toda ação do curador, do job e de relato). autorId null = sistema.
 */
model AnaliseCasoEvento {
  id        String          @id @default(uuid())
  casoId    String
  caso      AnaliseCasoDado @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autorId   String?
  // aberto|reporte|regra_disparou|regra_cessou|assumido|solto|decisao|nota|notificado
  tipo      String
  de        String?
  para      String?
  texto     String?         @db.VarChar(2000)
  createdAt DateTime        @default(now())

  @@index([casoId, createdAt])
  @@map("analise_casos_eventos")
}
