/**
 * Histórico de alterações visível ao usuário: registra edições feitas na
 * conta (pelo próprio usuário ou por consultor impersonando), categorizadas
 * por seção do app. `changes` guarda os pares antes/depois já filtrados por
 * allowlist — nunca senhas, hashes ou segredos TOTP. Retenção: 365 dias
 * (cron lgpd-retention).
 * Undo: `snapshot` guarda o estado pré-mutação ({ v, kind, data, meta })
 * allowlisted, gravado em exclusões/upserts para permitir reverter; nunca é
 * exposto na API de listagem. Entrada desfeita ganha `undoneAt`/`undoneById`;
 * o undo em si é uma nova entrada com `revertsId` apontando para a original
 * (sem FK — a original pode ser purgada pela retenção antes da entrada de undo).
 */
model UserChangeLog {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("UserChangeLogUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId       String?
  viaConsultant Boolean   @default(false)
  section       String
  action        String
  entity        String?
  entityId      String?
  entityLabel   String?
  changes       Json?
  snapshot      Json?
  undoneAt      DateTime?
  undoneById    String?
  revertsId     String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, section, createdAt])
  @@index([userId, entityId, createdAt])
  @@map("user_change_logs")
}

/**
 * Snapshot mensal da linha "Evolução do Patrimônio" do fluxo de caixa.
 * Gravado pelo cron no último dia útil de cada mês (regra Pedro Haddad):
 * trava o valor calculado (aportes nominais + fluxo livre) para que meses
 * fechados fiquem estáticos no histórico, imunes a edições retroativas.
 */
/**
 * Foto mensal dos indicadores de Saúde Financeira (pacote fechado em Json —
 * ninguém consulta campo a campo, e novos indicadores não pedem migração).
 * Gravada lazy pelo GET /api/saude-financeira (upsert do mês corrente);
 * alimenta as setas de tendência e o gráfico de evolução.
 */
model SaudeFinanceiraSnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("SaudeFinanceiraSnapshotUser", fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 0 = janeiro ... 11 = dezembro
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year])
  @@map("saude_financeira_snapshots")
}

/**
 * Apólice de seguro/proteção — bloco Gestão de Risco da Saúde Financeira.
 * Cadastro manual (não é ativo de carteira): risco e cobertura como enums
 * simples viram os eixos do bubble chart; custoAnual é o tamanho da bolha.
 */
model SeguroApolice {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("SeguroApoliceUser", fields: [userId], references: [id], onDelete: Cascade)
  nome            String
  tipo            String // 'vida' | 'saude' | 'auto' | 'residencial' | 'invalidez' | 'outro'
  cobertura       String // 'total' | 'parcial' | 'nenhuma'
  risco           String // 'baixo' | 'medio' | 'alto' — chance percebida de sinistro
  custoAnual      Decimal  @db.Decimal(15, 2)
  capitalSegurado Decimal? @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("seguro_apolices")
}

model CashflowPatrimonioSnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("CashflowPatrimonioSnapshotUser", fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 0 = janeiro ... 11 = dezembro
  valor     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year])
  @@map("cashflow_patrimonio_snapshots")
}

// ===== ECONOMIC INDEXES MODULE =====

model EconomicIndex {
  id        String   @id @default(uuid())
  indexType String // ver BACEN_SERIES em economicIndexesIngestion.ts: CDI, IPCA, TR, SELIC_*, IGPM, IMAB…
  date      DateTime // Data de referência
  value     Decimal  @db.Decimal(14, 6) // Taxa do período ou valor absoluto de índice (IMA-B pode exceder 9999)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indexType, date])
  @@index([indexType])
  @@index([date])
  @@index([indexType, date])
  @@map("economic_indexes")
}

// Cache de indicadores de mercado (IBOV, Dólar, BTC, ETH)
// Banco primeiro, fallback BRAPI quando cache expirado
model MarketIndicatorCache {
  id            String   @id @default(uuid())
  indicatorKey  String   @unique // "IBOV" | "USD-BRL" | "BTC" | "ETH"
  price         Decimal  @db.Decimal(18, 4)
  changePercent Decimal? @db.Decimal(10, 4)
  updatedAt     DateTime @updatedAt

  @@map("market_indicator_cache")
}

// Snapshot diário de patrimônio (pré-calculado pelo job; leitura rápida no resumo)
model PortfolioDailySnapshot {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime // início do dia (UTC/local consistente com o restante do app)
  totalValue    Decimal  @db.Decimal(18, 4) // saldo bruto
  totalInvested Decimal  @db.Decimal(18, 4) // valor aplicado
  totalEarnings Decimal  @db.Decimal(18, 4) // rendimentos acumulados (proventos no caixa do modelo)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("portfolio_daily_snapshots")
}

// Cache da "Sensibilidade da Carteira" (correlação ativo↔carteira + MRC).
// Invalidado por portfolioHash (mudança de composição) ou por idade (TTL na leitura).
model PortfolioSensibilidadeCache {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowMonths  Int // janela solicitada (12..60)
  portfolioHash String // sha256 de (symbol:quantity:avgPrice) ordenado
  payload       Json // SensibilidadeCarteiraResponse serializado
  computedAt    DateTime @default(now())

  @@unique([userId, windowMonths])
  @@index([userId])
  @@map("portfolio_sensibilidade_cache")
}

// Cache do payload completo de /api/analises/risco-retorno. Invalida quando a
// composição da carteira (hash de symbol:quantity:avgPrice) muda, com TTL de 24h.
model PortfolioRiscoRetornoCache {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioHash String // sha256 de (symbol:quantity:avgPrice) ordenado
  payload       Json // RiscoRetornoResponse serializado
  computedAt    DateTime @default(now())

  @@map("portfolio_risco_retorno_cache")
}

// Meta de patrimônio do usuário: "alcançar R$ X até ano Y". Singleton por userId.
model PortfolioGoal {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetEquity Decimal  @db.Decimal(15, 2) // patrimônio alvo em BRL
  targetYear   Int // ano-alvo (ex.: 2030); cálculo de cronograma assume dezembro
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portfolio_goals")
}

// TWR pré-calculado por dia (alinha ao historicoTWR do resumo)
model PortfolioPerformance {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  dailyReturn      Decimal? @db.Decimal(14, 8) // fração diária (ex.: 0.0012)
  cumulativeReturn Decimal  @db.Decimal(14, 6) // % acumulada TWR
  createdAt        DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("portfolio_performance")
}

// Preços diários de títulos do Tesouro Direto (fonte: Tesouro Transparente)
model TesouroDiretoPrice {
  id           String   @id @default(uuid())
  bondType     String // "Tesouro Selic", "Tesouro IPCA+", "Tesouro Prefixado", etc.
  maturityDate DateTime // Data de vencimento do título
  baseDate     DateTime // Data base da cotação
  buyRate      Decimal? @db.Decimal(10, 6) // Taxa compra manhã (% a.a.)
  sellRate     Decimal? @db.Decimal(10, 6) // Taxa venda manhã (% a.a.)
  buyPU        Decimal? @db.Decimal(18, 6) // PU compra manhã (R$)
  sellPU       Decimal? @db.Decimal(18, 6) // PU venda manhã (R$)
  basePU       Decimal? @db.Decimal(18, 6) // PU base manhã (R$)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bondType, maturityDate, baseDate])
  @@index([bondType, maturityDate])
  @@index([baseDate])
  @@map("tesouro_direto_prices")
}

// Cotas diárias de fundos de investimento (fonte: CVM Dados Abertos)
model CvmFundQuota {
  id           String   @id @default(uuid())
  cnpj         String // CNPJ do fundo (14 dígitos, sem formatação)
  date         DateTime // DT_COMPTC — data de referência da cota
  quotaValue   Decimal  @db.Decimal(18, 8) // VL_QUOTA — valor da cota (alta precisão)
  netWorth     Decimal? @db.Decimal(18, 2) // VL_PATRIM_LIQ — patrimônio líquido
  totalValue   Decimal? @db.Decimal(18, 2) // VL_TOTAL — valor total da carteira
  shareholders Int? // NR_COTST — número de cotistas
  dailyInflow  Decimal? @db.Decimal(18, 2) // CAPTC_DIA — captação do dia
  dailyOutflow Decimal? @db.Decimal(18, 2) // RESG_DIA — resgate do dia
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([cnpj, date])
  @@index([cnpj])
  @@index([date])
  @@map("cvm_fund_quotas")
}

// Objetivos financeiros do usuário (F3 — Planejamento Sonhos).
// Substitui o simulador de aposentadoria. Cada objetivo é uma meta financeira
// com prazo, valor desejado, valor inicial e rentabilidade esperada.
//
// O `category` é uma classificação por prazo (curto/médio/longo) — derivada de
// `months` mas armazenada pra evitar recalcular em filtros frequentes.
model PlanejamentoObjetivo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // "Reserva de Emergência", "Comprar Casa", etc.
  target    Decimal  @db.Decimal(15, 2) // Valor meta (R$)
  months    Int // Prazo em meses (1-480)
  startDate String? // YYYY-MM — opcional pra objetivos não iniciados
  available Decimal  @default(0) @db.Decimal(15, 2) // Valor disponível hoje
  rate      Decimal  @default(0) @db.Decimal(8, 6) // Rentabilidade ao mês (decimal: 0.01 = 1%)
  priority  String // "Alta" | "Moderado" | "Baixa"
  category  String // "c" (curto ≤12m) | "m" (médio 12-60m) | "l" (longo >60m)
  status    String // "Em espera" | "Iniciado" | "Pausado" | "Atrasado" | "Concluído"
  notes     String? // Observações livres
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries      PlanejamentoObjetivoEntry[]
  // Linha espelhada no fluxo de caixa (grupo "Planejamento Financeiro"). O
  // sonho é a fonte: o aporte mensal (pmt) é gravado nessa linha.
  cashflowItem CashflowItem?

  // Ativos da carteira vinculados a este sonho (realizado automático).
  portfolios Portfolio[]

  @@index([userId])
  @@index([userId, category])
  @@map("planejamento_objetivos")
}

// Registros mensais de progresso de um objetivo.
// Cada entrada captura o estado em um mês específico (saldo + aporte realizado),
// permitindo comparar com o planejado (calculado via PMT) e desenhar a evolução.
model PlanejamentoObjetivoEntry {
  id         String               @id @default(uuid())
  objetivoId String
  objetivo   PlanejamentoObjetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  month      String // YYYY-MM
  aporte     Decimal              @db.Decimal(15, 2) // Aporte realizado no mês
  balance    Decimal              @db.Decimal(15, 2) // Saldo ao fim do mês
  // "manual" = digitado no modal "Registrar Mês"; "auto" = derivado das células
  // verdes (realizadas) da linha-espelho no fluxo de caixa. Manual tem
  // precedência: o sync caixa→sonho nunca sobrescreve/remove entries manuais.
  source     String               @default("manual")
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([objetivoId, month])
  @@index([objetivoId])
  @@map("planejamento_objetivo_entries")
}

// Simulador de Aposentadoria (inspirado no protótipo "Planejamento completo").
// Um plano por usuário: parâmetros de projeção em termos reais (acumulação →
// saque) + acompanhamento mensal em termos nominais. Convive com o CRUD de
// objetivos (Sonhos) — são features separadas dentro de /planejamento-financeiro.
//
// `eventos` é um Json com aportes/resgates pontuais: [{ tipo, idade, valor }].
// Mantido como Json (não tabela) porque é uma lista curta editada em bloco
// junto com o resto dos parâmetros — espelha o estado único do protótipo.
model AposentadoriaPlano {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Perfil
  idade Int // idade atual
  apos  Int // idade de aposentadoria
  vida  Int // expectativa de vida

  // Taxas (% ao ano)
  rentNom       Decimal  @db.Decimal(6, 3) // rentabilidade nominal a.a.
  inflacao      Decimal  @db.Decimal(6, 3) // inflação esperada a.a.
  rentNomRetiro Decimal? @db.Decimal(6, 3) // taxa nominal na aposentadoria (null = igual à acumulação)

  // Acumulação / renda (R$ de hoje)
  patrimonio Decimal @db.Decimal(15, 2) // patrimônio inicial
  aporteM    Decimal @db.Decimal(15, 2) // aporte mensal
  renda      Decimal @db.Decimal(15, 2) // renda desejada na aposentadoria

  // Início do acompanhamento
  trackStartMonth Int // 1-12
  trackStartYear  Int

  // Eventos pontuais: [{ tipo: 'aporte'|'resgate', idade: number, valor: number }]
  eventos Json @default("[]")

  // Campos travados manualmente pelo usuário (override): não re-sincronizam do
  // contexto financeiro (carteira/fluxo de caixa). Ex.: ["aporteM","renda"].
  // Campos auto (ausentes daqui) refletem os dados ao vivo.
  fieldLocks Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AposentadoriaPlanoEntry[]

  @@map("aposentadoria_planos")
}

// Registro mensal de acompanhamento do plano de aposentadoria.
// `off` é o offset em meses a partir de (trackStartMonth/trackStartYear);
// year/month são desnormalizados pra exibição estável.
model AposentadoriaPlanoEntry {
  id         String             @id @default(uuid())
  planoId    String
  plano      AposentadoriaPlano @relation(fields: [planoId], references: [id], onDelete: Cascade)
  off        Int // mês do plano (1 = primeiro mês após o início)
  year       Int
  month      Int // 1-12
  aporteReal Decimal            @db.Decimal(15, 2) // aporte realizado no mês
  patFinal   Decimal            @db.Decimal(15, 2) // patrimônio ao fim do mês
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([planoId, off])
  @@index([planoId])
  @@map("aposentadoria_plano_entries")
}

// Dívidas do usuário — financiamentos com cronograma (SAC/Price) e dívidas
// rotativas sem cronograma (cartão, cheque especial). `modalidade` discrimina
// os dois formatos: campos de cronograma são null quando rotativa, e
// saldoInicial/dataSaldoInicial são null quando financiamento (união imposta
// no zod, seguindo a convenção de String + union em vez de enum Prisma).
//
// O cronograma SAC/Price nunca é persistido — é derivado do serviço puro
// (src/services/dividas/amortizacao.ts) a partir destes parâmetros. O saldo
// devedor também é sempre computado, nunca gravado.
model Divida {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  instituicao String?
  // 'financiamento_imobiliario' | 'financiamento_veiculo' | 'emprestimo_pessoal'
  // | 'consignado' | 'cartao_credito' | 'cheque_especial' | 'outro'
  tipo        String
  modalidade  String // 'financiamento' | 'rotativa'

  // ── Financiamento (null quando rotativa) ──
  principal          Decimal? @db.Decimal(15, 2) // valor financiado
  taxaAm             Decimal? @db.Decimal(8, 6) // taxa efetiva a.m. (decimal: 0.01 = 1%), sempre normalizada
  taxaUnidadeEntrada String   @default("am") // 'am' | 'aa' — como o usuário digitou (fidelidade ao reeditar)
  prazoMeses         Int? // 1..480
  sistema            String? // 'SAC' | 'PRICE'
  indexador          String   @default("PREFIXADO") // 'PREFIXADO' | 'TR' | 'IPCA' | 'CDI'
  primeiroVencimento String? // YYYY-MM

  // ── Rotativa (null quando financiamento) ──
  saldoInicial     Decimal? @db.Decimal(15, 2)
  dataSaldoInicial String? // YYYY-MM — âncora do saldo

  // Dia do mês do vencimento (1..31). Vale para financiamento (parcela) e
  // rotativa (fatura). Null = não informado → a Agenda cai no dia 1 e marca
  // `diaInformado: false`. Não entra no cronograma (amortização é mensal).
  diaVencimento Int?

  status    String   @default("ativa") // 'ativa' | 'quitada'
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagamentos   DividaPagamento[]
  // Linha-espelho no fluxo de caixa (grupo "Dívidas"). A dívida é a fonte:
  // as parcelas do cronograma são gravadas nessa linha (só financiamentos).
  cashflowItem CashflowItem?

  @@index([userId])
  @@index([userId, status])
  @@map("dividas")
}

// Pagamentos e ajustes de uma dívida. Sem unique(dividaId, month) de propósito:
// cartão pode ter vários pagamentos no mesmo mês. Unicidade de parcelaNumero
// por dívida é imposta na API (Prisma não tem partial unique).
model DividaPagamento {
  id            String  @id @default(uuid())
  dividaId      String
  divida        Divida  @relation(fields: [dividaId], references: [id], onDelete: Cascade)
  month         String // YYYY-MM
  valor         Decimal @db.Decimal(15, 2) // sempre positivo; `tipo` dá o sinal
  parcelaNumero Int? // financiamento: nº da parcela paga; null p/ rotativa e pagamentos extras
  // 'pagamento' reduz o saldo; 'ajuste' soma (encargos/novos saques da rotativa)
  tipo          String  @default("pagamento")
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dividaId])
  @@index([dividaId, month])
  @@map("divida_pagamentos")
}

// Trilha de auditoria de autenticação (login tracking).
// Append-only: cada tentativa de login (sucesso OU falha) gera uma linha.
// Falhas em conta inexistente têm userId=null mas email preenchido, pra
// rastrear ataques de enumeração/brute-force por e-mail.
//
// LGPD: ipAddress + userAgent são PII de segurança (legítimo interesse,
// Art. 7º IX). Retenção de 90 dias aplicada pelo cron lgpd-retention.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String? // null quando o e-mail não corresponde a nenhuma conta
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String // e-mail tentado (sempre gravado)
  success   Boolean
  // motivo da falha: "user_not_found" | "bad_password" | "totp_required"
  // | "totp_invalid" (null em sucesso)
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

// ===== Área Educacional (cursos Escolhi Ser Rico, vídeos hospedados na VTurb) =====

model Course {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  description   String?
  coverUrl      String?
  // Nível mínimo p/ assistir (paywall futuro): 0 = gratuito. Ver accessLevel.ts.
  requiredLevel Int            @default(0)
  orderIndex    Int            @default(0)
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  modules       CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String         @id @default(uuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Capa 16:9 do card na trilha (ex.: /educacao/modulos/01-boas-vindas.jpg).
  coverUrl    String?
  orderIndex  Int            @default(0)
  lessons     CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id              String           @id @default(uuid())
  moduleId        String
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  // Snippet de embed JS copiado do painel VTurb (Meus Vídeos → Embed → JS).
  // Null = aula ainda sem vídeo conectado (player mostra placeholder).
  vturbEmbed      String?
  durationSeconds Int?
  orderIndex      Int              @default(0)
  // Override por aula (ex.: 1ª aula gratuita num curso pago). Vale o MAIOR
  // entre requiredLevel do curso e da aula.
  requiredLevel   Int              @default(0)
  progresses      LessonProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

model LessonProgress {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation("LessonProgressUser", fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// Assistente de IA (set/2026): uma linha por chamada ao modelo — métricas por
// intenção/motor, uso de tokens (c/ cache) e custo, limite mensal por usuário
// (spec docs/assistente/especificacao-assistente-v1.1.md §7). Não guarda a
// conversa: `textoUsuario` só entra (truncado) nas intenções de revisão
// (outro / não suportado / recomendação de investimento).
// ---------------------------------------------------------------------------
model AssistenteMensagem {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation("AssistenteMensagemUser", fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Quem enviou: o próprio usuário ou o consultor agindo por ele.
   */
  actorId            String
  viaConsultant      Boolean  @default(false)
  intencao           String
  /**
   * 'ia' (só leitura) | 'ia+t' (gerou proposta de escrita)
   */
  motor              String
  modelo             String
  inputTokens        Int      @default(0)
  cachedInputTokens  Int      @default(0)
  cacheWriteTokens   Int      @default(0)
  outputTokens       Int      @default(0)
  custoBrl           Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs          Int      @default(0)
  stopReason         String   @default("n/a")
  ok                 Boolean  @default(true)
  propostaGerada     Boolean  @default(false)
  propostaConfirmada Boolean  @default(false)
  textoUsuario       String?
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("assistente_mensagens")
}

// ===== INTEGRAÇÃO BANCÁRIA (Pluggy / Open Finance) — Fase 2, set/2026 =====
// Ledger independente do provedor (docs/analise-pluggy-set2026.md §4):
// conexão (= item do Pluggy) → contas → transações. O fluxo de caixa é
// alimentado por agregação destas transações (Fase 2c), nunca o contrário.
// Regra "uma conta = um canal": conta conectada não recebe digitação manual.

/// Registro do consentimento Open Finance dado DENTRO do My Finance (adequação
/// jurídica 21/09/2026): prova de quem aceitou, quando, qual texto (versão +
/// hash) e quais produtos. NÃO tem FK para BankConnection de propósito — o
/// registro sobrevive à desconexão (fica "revogado"). Some só com a conta do
/// usuário (cascade), como o resto dos dados pessoais.
model OpenFinanceConsentimento {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation("OpenFinanceConsentimentoUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Versão do texto aceito (src/lib/openFinanceConsentimento.ts) e sha256 do conteúdo.
  versaoTexto     String
  hashTexto       String
  /// Produtos pedidos ao Pluggy nesta autorização (escopo).
  produtos        String[]
  /// pendente → ativo (conexão criada) → revogado | substituido; nao_concluido = widget fechado/erro.
  status          String    @default("pendente")
  /// true = reconexão de uma conexão existente (renovação do consentimento).
  reconexao       Boolean   @default(false)
  ip              String?
  userAgent       String?
  aceitoEm        DateTime  @default(now())
  /// Preenchidos quando o widget conclui e a conexão é registrada.
  connectionId    String?
  providerItemId  String?
  connectorName   String?
  vinculadoEm     DateTime?
  revogadoEm      DateTime?
  /// usuario | substituido | instituicao
  motivoRevogacao String?
  /// IP de quem desconectou (só na revogação pelo usuário).
  ipRevogacao     String?
  /// Linha do tempo da etapa externa (eventos do widget Pluggy: banco escolhido,
  /// consentimento enviado, login concluído, fechou sem concluir, erro). O My
  /// Finance só vê esses marcos, nunca o conteúdo das telas da Pluggy/banco.
  eventos         Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([connectionId])
  @@map("open_finance_consentimentos")
}

/// De onde veio cada posição/dívida importada do banco (chave estável, sem os
/// ids do Pluggy, que mudam a cada conexão). Sobrevive à desconexão: ao
/// conectar o mesmo banco de novo, o importador VINCULA em vez de duplicar
/// (bug achado em 21/09/2026). Some com a conta do usuário.
model PluggyImportacaoOrigem {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation("PluggyImportacaoOrigemUser", fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 de instituição + identificação do produto (ver importarCarteira.ts).
  chave              String
  /// investimento | emprestimo
  tipo               String
  assetId            String?
  portfolioId        String?
  fixedIncomeAssetId String?
  dividaId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, chave])
  @@map("pluggy_importacao_origens")
}

model BankConnection {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation("BankConnectionUser", fields: [userId], references: [id], onDelete: Cascade)
  provider           String    @default("pluggy")
  /**
   * Id do item no Pluggy. Um item por CPF × instituição (limites mensais do
   * Open Finance são consumidos por item).
   */
  providerItemId     String    @unique
  connectorId        Int
  connectorName      String
  connectorImageUrl  String?
  isOpenFinance      Boolean   @default(false)
  isSandbox          Boolean   @default(false)
  /**
   * Status do item no Pluggy: UPDATING | UPDATED | LOGIN_ERROR | OUTDATED | WAITING_USER_INPUT
   */
  status             String    @default("UPDATING")
  executionStatus    String?
  errorMessage       String?
  consentExpiresAt   DateTime?
  providerUpdatedAt  DateTime?
  /**
   * Último sync NOSSO bem-sucedido (contas + transações gravadas).
   */
  lastSyncAt         DateTime?
  lastSyncError      String?
  /**
   * Última atualização manual (PATCH /items) — cooldown, ver services/pluggy/sync.ts.
   */
  lastManualUpdateAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts    BankAccount[]
  investments BankInvestment[]
  loans       BankLoan[]

  @@index([userId])
  @@index([status])
  @@map("bank_connections")
}

model BankAccount {
  id                String         @id @default(uuid())
  connectionId      String
  connection        BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation("BankAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  providerAccountId String         @unique
  type              String // BANK | CREDIT
  subtype           String? // CHECKING_ACCOUNT | SAVINGS_ACCOUNT | CREDIT_CARD
  name              String
  /**
   * Número mascarado como o provedor devolve (nunca agência/conta completos de terceiros).
   */
  number            String?
  currencyCode      String         @default("BRL")
  balance           Decimal        @default(0) @db.Decimal(15, 2)
  balanceAt         DateTime?
  // Cartão de crédito
  creditLimit       Decimal?       @db.Decimal(15, 2)
  creditAvailable   Decimal?       @db.Decimal(15, 2)
  creditBrand       String?
  creditDueDate     DateTime?
  creditClosingDate DateTime?
  /**
   * false = usuário escolheu não usar esta conta no MyFinance (continua sincronizando o item).
   */
  ativa             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  transactions BankTransaction[]

  @@index([userId])
  @@index([connectionId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                 String        @id @default(uuid())
  accountId          String
  account            BankAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation("BankTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Id no Pluggy. Pode mudar quando data/descrição/valor mudam — por isso o dedupHash.
   */
  providerTxId       String        @unique
  /**
   * sha256(conta local | data | valor | descrição): reconhece id trocado dentro da mesma conta.
   */
  dedupHash          String
  /**
   * sha256(usuário | banco | nº da conta | data | valor | descrição): reconhece a
   * MESMA transação chegando por outra conexão (banco conectado duas vezes).
   * Null só em linhas anteriores à migration; preenchido no próximo sync.
   */
  globalHash         String?
  /**
   * Id da transação original quando esta é cópia por outra conexão; fica fora da Caixa de entrada e das células.
   */
  duplicadaDe        String?
  date               DateTime
  description        String
  descriptionRaw     String?
  /**
   * Valor com o sinal do provedor: conta → negativo = saída; cartão →
   * positivo = compra (aumenta a fatura), negativo = pagamento/estorno.
   * `type` (DEBIT/CREDIT) é a fonte da verdade do sentido.
   */
  amount             Decimal       @db.Decimal(15, 2)
  type               String // DEBIT | CREDIT
  status             String        @default("POSTED") // POSTED | PENDING
  currencyCode       String        @default("BRL")
  providerCategory   String?
  providerCategoryId String?
  merchantName       String?
  merchantCnpj       String?
  paymentMethod      String? // PIX | TED | DOC | BOLETO …
  /**
   * Nome da contraparte (pagador em crédito, recebedor em débito). Sem documento (LGPD).
   */
  counterpartName    String?
  installmentNumber  Int?
  installmentTotal   Int?
  billId             String?
  /**
   * Usuário marcou para não considerar (transferência entre contas próprias, etc.).
   */
  ignorada           Boolean       @default(false)
  /**
   * Linha do fluxo de caixa em que a transação foi aplicada (Caixa de entrada,
   * Fase 2c). null = pendente. A célula (item, ano, mês) passa a ser a soma
   * das transações aplicadas — "uma conta = um canal".
   */
  cashflowItemId     String?
  cashflowItem       CashflowItem? @relation("BankTransactionCashflowItem", fields: [cashflowItemId], references: [id], onDelete: SetNull)
  appliedAt          DateTime?
  /**
   * Removida no provedor (evento transactions/deleted ou sumiu na reconciliação da janela).
   */
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, date])
  @@index([accountId, date])
  @@index([accountId, dedupHash])
  @@index([userId, globalHash])
  @@index([cashflowItemId])
  @@index([userId, appliedAt])
  @@map("bank_transactions")
}

/**
 * Fila de eventos do webhook do Pluggy. O receptor só grava; o cron
 * /api/cron/pluggy-sync processa (a rota precisa responder em 10 s).
 */
model PluggyWebhookEvent {
  id             String    @id @default(uuid())
  event          String
  providerItemId String?
  payload        Json
  status         String    @default("pending") // pending | processing | done | error | ignored
  attempts       Int       @default(0)
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, receivedAt])
  @@index([providerItemId])
  @@map("pluggy_webhook_events")
}

/**
 * Espelho de uma POSIÇÃO de investimento devolvida pelo provedor (Fase 3).
 * A Carteira continua sendo a fonte de valor: aqui só fica o vínculo
 * (assetId/portfolioId/fixedIncomeAssetId) e o status da importação.
 * Sem FK para Asset/Portfolio/FixedIncomeAsset de propósito: exclusões na
 * Carteira não podem depender do espelho; o serviço trata vínculo pendurado.
 */
model BankInvestment {
  id                   String         @id @default(uuid())
  connectionId         String
  connection           BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId               String
  user                 User           @relation("BankInvestmentUser", fields: [userId], references: [id], onDelete: Cascade)
  providerInvestmentId String         @unique
  type                 String // FIXED_INCOME | MUTUAL_FUND | EQUITY | ETF | SECURITY | COE
  subtype              String? // CDB, LCI, REAL_ESTATE_FUND, PGBL…
  name                 String
  code                 String? // ticker (BOVA11) ou CNPJ do fundo
  isin                 String?
  number               String?
  balance              Decimal        @default(0) @db.Decimal(15, 2)
  quantity             Float?
  unitValue            Float?
  amountOriginal       Decimal?       @db.Decimal(15, 2)
  amountProfit         Decimal?       @db.Decimal(15, 2)
  rate                 Float?
  rateType             String? // CDI | IPCA | SELIC | PRE…
  fixedAnnualRate      Float?
  issueDate            DateTime?
  dueDate              DateTime?
  issuer               String?
  status               String? // ACTIVE | TOTAL_WITHDRAWAL…
  providerDate         DateTime?
  /**
   * false = sumiu do provedor na última sincronização.
   */
  ativo                Boolean        @default(true)
  assetId              String?
  portfolioId          String?
  fixedIncomeAssetId   String?
  /**
   * pendente | importado | vinculado | ignorado | sem-suporte | erro
   */
  importStatus         String         @default("pendente")
  importError          String?
  importedAt           DateTime?
  /// confirmado pelo usuário ou sem escolha; null + importado = para conferir
  destinoConfirmadoEm  DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([connectionId])
  @@index([userId, importStatus])
  @@map("bank_investments")
}

/**
 * Espelho de uma operação de crédito (empréstimo/financiamento) do provedor.
 */
model BankLoan {
  id                      String         @id @default(uuid())
  connectionId            String
  connection              BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User           @relation("BankLoanUser", fields: [userId], references: [id], onDelete: Cascade)
  providerLoanId          String         @unique
  contractNumber          String?
  productName             String
  type                    String?
  contractAmount          Decimal?       @db.Decimal(15, 2)
  outstanding             Decimal?       @db.Decimal(15, 2)
  nextInstallmentAmount   Decimal?       @db.Decimal(15, 2)
  cet                     Float?
  annualRate              Float?
  indexer                 String?
  amortization            String? // SAC | PRICE | SAM
  periodicity             String?
  totalInstallments       Int?
  paidInstallments        Int?
  dueInstallments         Int?
  pastDueInstallments     Int?
  contractDate            DateTime?
  firstInstallmentDueDate DateTime?
  dueDate                 DateTime?
  ativo                   Boolean        @default(true)
  dividaId                String?
  /**
   * pendente | importado | vinculado | ignorado | sem-suporte | erro
   */
  importStatus            String         @default("pendente")
  importError             String?
  importedAt              DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId])
  @@index([connectionId])
  @@map("bank_loans")
}

// ============================================================
// Comunidade (pedido do Pedro, 23/09/2026) — feed de posts de texto, curtidas,
// comentários e moderação posterior pela equipe. Conteúdo removido é soft
// delete (excluidoEm = pelo autor; ocultoEm = pela moderação) para a fila de
// denúncias e o registro exigido pelo Marco Civil.
// ============================================================

enum CommunityCargo {
  membro
  // Equipe My Finance: selo no perfil + modera + fixa posts
  equipe
}

model CommunityProfile {
  userId         String         @id
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?        @db.VarChar(280)
  cargo          CommunityCargo @default(membro)
  termoVersao    String
  termoAceitoEm  DateTime
  suspensoAte    DateTime?
  suspensoMotivo String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("community_profiles")
}

model CommunityPost {
  id           String             @id @default(uuid())
  authorId     String
  author       User               @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoria    String
  conteudo     String
  fixadoEm     DateTime?
  editadoEm    DateTime?
  excluidoEm   DateTime?
  ocultoEm     DateTime?
  ocultoPorId  String?
  ocultoMotivo String?
  ipAddress    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  comments     CommunityComment[]
  likes        CommunityLike[]
  reports      CommunityReport[]

  @@index([createdAt])
  @@index([categoria, createdAt])
  @@index([authorId, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id           String            @id @default(uuid())
  postId       String
  post         CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User              @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  conteudo     String
  editadoEm    DateTime?
  excluidoEm   DateTime?
  ocultoEm     DateTime?
  ocultoPorId  String?
  ocultoMotivo String?
  ipAddress    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reports      CommunityReport[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_comments")
}

model CommunityLike {
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
  @@index([userId])
  @@map("community_likes")
}

model CommunityReport {
  id             String            @id @default(uuid())
  reporterId     String
  reporter       User              @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  postId         String?
  post           CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  motivo         String
  detalhe        String?
  // aberta | resolvida | descartada
  status         String            @default("aberta")
  resolvidoPorId String?
  resolvidoEm    DateTime?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("community_reports")
}

// ===== ANÁLISE DE ATIVOS (Fase 0) =====
// Fundação de dados da área "Análise de Ativos" (docs/analise-ativos/fase0/spec-fase0.json).
// Tabelas novas, sem FKs entre si nem para tabelas existentes (ingestão independente de ordem);
// ligação por symbol/cnpj. Cada tabela tem UMA fatia escritora; leituras cruzadas só por
// src/services/analiseAtivos/repositorio/**. Percentuais em pontos percentuais (sufixo Pct).
// Três estados: coluna numérica null + naoSeAplica[] = n/a; null fora do array = ausente.

// Versões imutáveis dos limiares (spec §8). Ativa = maior version com validFrom ≤ agora.
model ScoringParams {
  id        String   @id @default(uuid())
  version   Int      @unique
  // validado por scoringParamsSchema (zod) na leitura E na escrita
  params    Json
  validFrom DateTime
  // 'seed-fase0' | e-mail do admin
  createdBy String
  notas     String?
  createdAt DateTime @default(now())

  @@index([validFrom])
  @@map("scoring_params")
}

model AnaliseJobRun {
  id             String    @id @default(uuid())
  // ver src/services/analiseAtivos/jobs/nomesJobs.ts
  job            String
  // cron | script
  origem         String    @default("cron")
  // executando | ok | parcial | falha | pulado | abandonado
  status         String
  inicio         DateTime  @default(now())
  fim            DateTime?
  duracaoMs      Int?
  linhasLidas    Int       @default(0)
  linhasGravadas Int       @default(0)
  rejeitadas     Int       @default(0)
  // AlertaJob[] (máx. 200, truncado com contador)
  alertas        Json?
  erro           String?
  rssInicioMb    Int?
  rssPicoMb      Int?
  parametros     Json?
  // arquivos processados (url, etag, versões), cursores
  detalhes       Json?

  @@index([job, inicio(sort: Desc)])
  @@index([status])
  @@map("analise_job_runs")
}

// ETag/sha256 dos arquivos de fonte: pula download/processamento de arquivo inalterado.
model AnaliseFonteArquivo {
  url          String    @id
  etag         String?
  lastModified String?
  bytes        BigInt?
  sha256       String?
  baixadoEm    DateTime
  // só após gravação OK; arquivo baixado e não processado é reprocessado
  processadoEm DateTime?
  jobUltimo    String?

  @@map("analise_fonte_arquivos")
}

model CvmCompany {
  // 14 dígitos sem máscara
  cnpj              String   @id
  cdCvm             String
  nome              String
  // só referência; setor oficial = AssetSetorB3
  setorAtividadeFca String?
  situacao          String?
  // 12 na maioria; ~10 cias fora de dezembro (regra 19)
  mesFimExercicio   Int?
  // DRE de banco/seguradora; fallback de financeira quando não há AssetSetorB3
  layoutFinanceiro  Boolean  @default(false)
  dataRefFca        DateTime @db.Date
  versaoFca         Int
  sourceUrl         String
  fetchedAt         DateTime

  @@index([cdCvm])
  @@map("cvm_companies")
}

// validFrom = Data_Inicio_Negociacao do FCA ou 1ª data em que o par foi visto — nunca a data
// de referência de cada FCA anual. Linha nova só quando cnpj/classe mudam.
model CvmCompanyTicker {
  id              String    @id @default(uuid())
  symbol          String
  cnpj            String
  // ON | PN | UNIT — pelo SUFIXO do ticker (regra 18)
  classeTitulo    String
  // como veio no FCA (MGLU3 vem PN)
  classeFca       String?
  unitQtdOn       Int?
  unitQtdPn       Int?
  composicaoTexto String?
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  // fca | manual
  origem          String    @default("fca")
  fetchedAt       DateTime

  @@unique([symbol, validFrom])
  @@index([cnpj])
  @@index([symbol])
  @@map("cvm_company_tickers")
}

// Point-in-time: todas as versões CVM (unique inclui versao); leitura pega a maior.
model AssetFundamentalsPeriod {
  id                     String   @id @default(uuid())
  // CNPJ (CVM) | 'CIK:<10 dígitos>' (SEC, Fase 4)
  emissorId              String
  // CVM | SEC
  source                 String
  // DFP | ITR | 10-K | 10-Q
  docTipo                String
  docId                  String?
  accession              String?
  sourceConcept          Json?
  sourceUrl              String
  // FY | YTD | 3M | TTM (TTM derivado pela fatia A, regra 14)
  tipoPeriodo            String
  // con | ind
  escopo                 String
  // IFRS | BRGAAP | USGAAP
  padraoContabil         String
  dtIni                  DateTime @db.Date
  dtFim                  DateTime @db.Date
  anoFiscal              Int
  trimestreFiscal        Int?
  versao                 Int
  // DT_RECEB desta versão
  dtEntrega              DateTime @db.Date
  // menor DT_RECEB do (cnpj, DT_REFER)
  dtEntregaOriginal      DateTime @db.Date
  moeda                  String   @default("BRL")
  // UNIDADE | MIL
  escalaOriginal         String
  receita                Decimal? @db.Decimal(20, 2)
  lucroBruto             Decimal? @db.Decimal(20, 2)
  ebit                   Decimal? @db.Decimal(20, 2)
  // DFC 6.01.01.* (positivo)
  depreciacaoAmortizacao Decimal? @db.Decimal(20, 2)
  lucroLiquido           Decimal? @db.Decimal(20, 2)
  // controladora; null quando regra 12
  lucroAtribuivel        Decimal? @db.Decimal(20, 2)
  codContaLucro          String?
  ativoTotal             Decimal? @db.Decimal(20, 2)
  ativoCirculante        Decimal? @db.Decimal(20, 2)
  passivoCirculante      Decimal? @db.Decimal(20, 2)
  caixa                  Decimal? @db.Decimal(20, 2)
  aplicacoesFinanceiras  Decimal? @db.Decimal(20, 2)
  dividaBrutaCp          Decimal? @db.Decimal(20, 2)
  dividaBrutaLp          Decimal? @db.Decimal(20, 2)
  pl                     Decimal? @db.Decimal(20, 2)
  plControladora         Decimal? @db.Decimal(20, 2)
  fco                    Decimal? @db.Decimal(20, 2)
  fci                    Decimal? @db.Decimal(20, 2)
  fcf                    Decimal? @db.Decimal(20, 2)
  // positivo = saída
  capex                  Decimal? @db.Decimal(20, 2)
  // DFC 6.03 (positivo)
  dividendosJcpPagos     Decimal? @db.Decimal(20, 2)
  // só FY; 'declarado no ano'
  dmplDeclarado          Decimal? @db.Decimal(20, 2)
  // publicado 3.99.01.x, já com escala corrigida (regra 11)
  lpaOn                  Float?
  lpaPn                  Float?
  lpaEscalaCorrigida     Boolean  @default(false)
  naoSeAplica            String[]
  flags                  String[]
  fetchedAt              DateTime

  @@unique([emissorId, dtFim, tipoPeriodo, escopo, versao])
  @@index([emissorId, tipoPeriodo, dtFim])
  @@index([fetchedAt])
  @@map("asset_fundamentals_period")
}

// Linhas dos demonstrativos (Raio-X). Tabela grande: chave composta, sem uuid.
