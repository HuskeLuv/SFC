// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  consultant
  admin
}

enum ConsultantClientStatus {
  active
  inactive
}

enum ConsultantInviteStatus {
  pending
  accepted
  rejected
}

enum FixedIncomeType {
  CDB_PRE
  LC_PRE
  LCI_PRE
  LCA_PRE
  RDB_PRE
  LF_PRE
  LFS_PRE
  CRI_PRE
  CRA_PRE
  DPGE_PRE
  RDC_PRE
  LIG_PRE
  CDB_HIB
  LC_HIB
  LCI_HIB
  LCA_HIB
  RDB_HIB
  LF_HIB
  LFS_HIB
  CRI_HIB
  CRA_HIB
  DPGE_HIB
  RDC_HIB
  LIG_HIB
}

enum FixedIncomeIndexer {
  PRE
  CDI
  IPCA
}

enum FixedIncomeLiquidity {
  DAILY
  MATURITY
}

model User {
  id                            String                        @id @default(uuid())
  email                         String                        @unique
  password                      String
  name                          String
  avatarUrl                     String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  role                          UserRole                      @default(user)
  // LGPD #12: 2FA TOTP. totpSecret é base32 (RFC 4226). Hoje plain text;
  // débito técnico — migrar pra KMS-encrypted quando estiver em AWS.
  // totpEnabled = false durante o setup; só vira true depois que o user
  // confirma com código válido.
  totpSecret                    String?
  totpEnabled                   Boolean                       @default(false)
  // Caixa para Investir: proventos pagos a partir desta data entram no caixa
  // livre (null = desligado). Não retroativo: ligar grava o dia de hoje.
  caixaProventosDesde           DateTime?
  // Revogação de sessões (PWA fase 0): o JWT carrega este número no claim
  // `sv`; incrementar derruba todas as sessões emitidas antes.
  sessionVersion                Int                           @default(0)
  events                        Event[]
  dashboard                     DashboardData[]
  cashflowGroups                CashflowGroup[]
  cashflowItems                 CashflowItem[]
  cashflowValues                CashflowValue[]
  consultantProfile             Consultant?
  consultancies                 ClientConsultant[]            @relation("ClientConsultantClients")
  // Stocks
  watchlists                    Watchlist[]
  portfolios                    Portfolio[]
  stockTransactions             StockTransaction[]
  portfolioProventos            PortfolioProvento[]
  fixedIncomeAssets             FixedIncomeAsset[]
  notifications                 Notification[]
  consultantInvites             ConsultantInvite[]            @relation("UserConsultantInvites")
  impersonationLogsAsConsultant ConsultantImpersonationLog[]  @relation("ImpersonationLogConsultant")
  impersonationLogsAsClient     ConsultantImpersonationLog[]  @relation("ImpersonationLogClient")
  alocacaoConfigs               AlocacaoConfig[]
  portfolioDailySnapshots       PortfolioDailySnapshot[]
  portfolioPerformances         PortfolioPerformance[]
  sensibilidadeCaches           PortfolioSensibilidadeCache[]
  riscoRetornoCache             PortfolioRiscoRetornoCache?
  portfolioGoal                 PortfolioGoal?
  planejamentoObjetivos         PlanejamentoObjetivo[]
  aposentadoriaPlano            AposentadoriaPlano?
  dividas                       Divida[]
  consents                      UserConsent[]
  loginEvents                   LoginEvent[]
  changeLogs                    UserChangeLog[]               @relation("UserChangeLogUser")
  cashflowPatrimonioSnapshots   CashflowPatrimonioSnapshot[]  @relation("CashflowPatrimonioSnapshotUser")
  cashflowOrcamentos            CashflowOrcamento[]           @relation("CashflowOrcamentoUser")
  saudeFinanceiraSnapshots      SaudeFinanceiraSnapshot[]     @relation("SaudeFinanceiraSnapshotUser")
  seguroApolices                SeguroApolice[]               @relation("SeguroApoliceUser")
  lessonProgresses              LessonProgress[]              @relation("LessonProgressUser")
  // Comunidade (23/09/2026)
  communityProfile              CommunityProfile?
  communityPosts                CommunityPost[]               @relation("CommunityPostAuthor")
  communityComments             CommunityComment[]            @relation("CommunityCommentAuthor")
  communityLikes                CommunityLike[]
  communityReports              CommunityReport[]             @relation("CommunityReportReporter")
  assistenteMensagens           AssistenteMensagem[]          @relation("AssistenteMensagemUser")
  bankConnections               BankConnection[]              @relation("BankConnectionUser")
  openFinanceConsentimentos     OpenFinanceConsentimento[]    @relation("OpenFinanceConsentimentoUser")
  pluggyImportacaoOrigens       PluggyImportacaoOrigem[]      @relation("PluggyImportacaoOrigemUser")
  bankAccounts                  BankAccount[]                 @relation("BankAccountUser")
  bankTransactions              BankTransaction[]             @relation("BankTransactionUser")
  bankInvestments               BankInvestment[]              @relation("BankInvestmentUser")
  bankLoans                     BankLoan[]                    @relation("BankLoanUser")
  // Nível de acesso do usuário (paywall futuro): 0 = gratuito; níveis maiores
  // liberam conteúdos/seções com requiredLevel <= accessLevel. Ver
  // src/utils/accessLevel.ts.
  accessLevel                   Int                           @default(0)
  agendaPreferencia             AgendaPreferencia?
  // Web push (PWA fase 5)
  pushSubscriptions             PushSubscription[]
  pushPreferencia               PushPreferencia?
  // Análise de Ativos — Fase 1 (tese privada e lista do beta)
  analiseTeses                  AnaliseTese[]                 @relation("AnaliseTeseUser")
  featureBetas                  FeatureBetaUser[]             @relation("FeatureBetaUserUser")
  analiseCasosResponsavel       AnaliseCasoDado[]             @relation("AnaliseCasoResponsavel")
  analiseReportes               AnaliseDataReport[]           @relation("AnaliseReporteAutor")
  analiseReportesCliente        AnaliseDataReport[]           @relation("AnaliseReporteCliente")
}

/**
 * Preferências da Agenda financeira. Linha criada sob demanda: quem nunca
 * mexeu não tem registro e vale o padrão (lembretes ligados).
 */
model AgendaPreferencia {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // false = o cron não gera notificação de lembrete para este usuário.
  lembretes    Boolean   @default(true)
  // Token do feed iCal (a URL é pública: o token É a credencial). Null = sem
  // feed publicado; regerar o token invalida o link antigo na hora.
  icalToken    String?   @unique
  icalCriadoEm DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("agenda_preferencias")
}

/**
 * Assinatura de web push de UM aparelho/navegador (PWA fase 5). O endpoint é a
 * identidade da assinatura (upsert por endpoint reconcilia rotação); um
 * usuário pode ter várias (celular + desktop). userAgent alimenta o rótulo da
 * lista de aparelhos no Perfil.
 */
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * Preferência de push por categoria (PWA fase 5). Linha criada sob demanda,
 * no molde da AgendaPreferencia: sem registro = tudo ligado.
 */
model PushPreferencia {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orcamento  Boolean  @default(true)
  agenda     Boolean  @default(true)
  comunidade Boolean  @default(true)
  conta      Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("push_preferencias")
}

/**
 * Registro de consentimento LGPD (Art. 8º §1º). Persiste o aceite do
 * usuário aos Termos de Uso e Política de Privacidade — exigência pra
 * que o consentimento seja juridicamente válido (informado, expresso,
 * rastreável).
 * Cada nova versão da política/termos gera novo registro (uma versão
 * vigente por documento). Revogação cria registro com `revokedAt` ≠ null
 * — mantemos histórico em vez de delete pra cumprir Art. 9º §2º.
 */
model UserConsent {
  id              String    @id @default(uuid())
  userId          String
  documentType    String // "privacy-policy" | "terms-of-use"
  documentVersion String // ex. "1.0"
  acceptedAt      DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, documentType])
  @@map("user_consents")
}

model Consultant {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  clients   ClientConsultant[]
  invites   ConsultantInvite[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ClientConsultant {
  id           String                 @id @default(uuid())
  consultantId String
  consultant   Consultant             @relation(fields: [consultantId], references: [id])
  clientId     String
  client       User                   @relation("ClientConsultantClients", fields: [clientId], references: [id])
  createdAt    DateTime               @default(now())
  status       ConsultantClientStatus @default(active)

  @@unique([consultantId, clientId])
  @@index([clientId])
}

model ConsultantInvite {
  id            String                 @id @default(uuid())
  consultantId  String
  consultant    Consultant             @relation(fields: [consultantId], references: [id])
  invitedUserId String?
  invitedUser   User?                  @relation("UserConsultantInvites", fields: [invitedUserId], references: [id])
  email         String
  status        ConsultantInviteStatus @default(pending)
  token         String                 @unique
  createdAt     DateTime               @default(now())
  respondedAt   DateTime?
  notifications Notification[]

  @@index([invitedUserId])
  @@index([consultantId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())
  inviteId  String?
  invite    ConsultantInvite? @relation(fields: [inviteId], references: [id])

  @@index([userId, createdAt])
}

// Evento escrito pelo usuário na Agenda (página Calendário). Eventos de
// dívidas, proventos, renda fixa etc. NÃO ficam aqui: são calculados na hora
// pelas fontes em src/services/calendario/. Datas são civis (AAAA-MM-DD à
// meia-noite UTC); a hora, quando existe, é texto "HH:MM" sem fuso.
model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime // dia do evento (00:00 UTC)
  endDate     DateTime? // último dia, inclusive, para eventos de vários dias
  hora        String? // "HH:MM"; null = dia inteiro
  categoria   String    @default("pessoal") // 'pessoal' | 'pagamento' | 'recebimento' | 'lembrete'
  recorrencia String    @default("nenhuma") // 'nenhuma' | 'mensal' | 'anual'
  lembrete    Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, date])
}

model DashboardData {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  metric String
  value  Float

  @@index([userId])
}

model AlocacaoConfig {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  categoria String
  minimo    Float
  maximo    Float
  target    Float
  descricao String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoria])
  @@index([userId])
  @@map("alocacao_configs")
}

model CashflowGroup {
  id         String              @id @default(uuid())
  userId     String? // null se for grupo padrão (template)
  user       User?               @relation(fields: [userId], references: [id])
  name       String
  type       String // 'entrada', 'despesa' ou 'investimento'
  parentId   String? // FK para outro grupo (subgrupo)
  parent     CashflowGroup?      @relation("SubGroups", fields: [parentId], references: [id])
  children   CashflowGroup[]     @relation("SubGroups")
  items      CashflowItem[]
  orderIndex Int                 @default(0)
  // Override layer: quando setado, esta linha personaliza o template apontado.
  // Permite link estável entre override e template (mais robusto que match por nome).
  templateId String?
  template   CashflowGroup?      @relation("GroupOverride", fields: [templateId], references: [id])
  overrides  CashflowGroup[]     @relation("GroupOverride")
  // Tombstone: usuário ocultou um template. Override row com hidden=true some do tree.
  hidden     Boolean             @default(false)
  orcamentos CashflowOrcamento[] @relation("CashflowOrcamentoGroup")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, templateId])
  @@index([userId])
  @@index([parentId])
  @@index([templateId])
}

model CashflowItem {
  id          String                @id @default(uuid())
  userId      String? // null se for item padrão (template)
  user        User?                 @relation(fields: [userId], references: [id])
  groupId     String
  group       CashflowGroup         @relation(fields: [groupId], references: [id])
  name        String
  significado String? // explicação opcional
  rank        String? // ordem de importância (essencial, normal, etc.)
  // Posição da linha dentro do grupo (reordenável pelo usuário, ago/2026).
  // Backfill da migração preservou a ordem alfabética que era exibida antes.
  orderIndex  Int                   @default(0)
  // Override layer: quando setado, esta linha personaliza o item-template apontado.
  templateId  String?
  template    CashflowItem?         @relation("ItemOverride", fields: [templateId], references: [id])
  overrides   CashflowItem[]        @relation("ItemOverride")
  // Tombstone: usuário ocultou um item-template.
  hidden      Boolean               @default(false)
  // Vínculo opcional com um objetivo do Planejamento de Sonhos. Quando setado,
  // esta linha é espelho do sonho (somente-leitura no fluxo de caixa) e seus
  // valores mensais são o aporte mensal (pmt) sincronizado pelo planejamento.
  objetivoId  String?               @unique
  objetivo    PlanejamentoObjetivo? @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  // Vínculo opcional com uma dívida. Quando setado, esta linha é espelho do
  // financiamento (somente-leitura no fluxo de caixa) e seus valores mensais
  // são as parcelas do cronograma SAC/Price sincronizadas pela área de Dívidas.
  dividaId    String?               @unique
  divida      Divida?               @relation(fields: [dividaId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  values           CashflowValue[]
  bankTransactions BankTransaction[] @relation("BankTransactionCashflowItem")

  @@unique([userId, templateId])
  @@index([groupId])
  @@index([userId])
  @@index([templateId])
}

// Meta mensal de orçamento da seção "Orçamento vs Real": um valor por
// (usuário, ano, categoria). A categoria é um CashflowGroup de despesa
// (grupo ou subgrupo). A linha especial de investimentos usa groupId=null
// com tipo='investimentos' e tipoMeta='percentual' (% da renda do mês);
// a unicidade dela é garantida por índice parcial criado na migration
// (Postgres trata NULLs como distintos em unique compostas).
model CashflowOrcamento {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation("CashflowOrcamentoUser", fields: [userId], references: [id], onDelete: Cascade)
  groupId   String? // null apenas na linha especial de investimentos
  group     CashflowGroup? @relation("CashflowOrcamentoGroup", fields: [groupId], references: [id], onDelete: Cascade)
  tipo      String         @default("grupo") // 'grupo' | 'investimentos'
  year      Int
  tipoMeta  String         @default("valor") // 'valor' (R$/mês) | 'percentual' (% da renda)
  valor     Decimal        @db.Decimal(15, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, year, tipo, groupId])
  @@index([userId, year])
  @@map("cashflow_orcamentos")
}

model CashflowValue {
  id        String       @id @default(uuid())
  itemId    String
  item      CashflowItem @relation(fields: [itemId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  year      Int
  month     Int // 0 = Jan, 11 = Dez
  value     Decimal      @db.Decimal(15, 2)
  formula   String? // Fórmula estilo Excel que gerou o valor (ex.: '=200+30+50') — ticket 31/08/2026
  // Parte de `value` que veio de transações do banco (Caixa de entrada, Pluggy). O banco SOMA ao
  // que o usuário digitou: lançar/desfazer ajusta `value` pela diferença (06/10/2026).
  valorBanco Decimal     @default(0) @db.Decimal(15, 2)
  color     String? // Cor do texto (formato CSS: #000000, green, red, etc.)
  comment   String? // Comentário da célula
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([itemId, userId, year, month])
  @@index([itemId])
  @@index([userId])
}

// ===== PORTFOLIO MODULE =====
// Pós-consolidação Stock → Asset (Sprint 5): `Stock` removido, ações/FIIs
// também vivem em `Asset` (type='stock' / 'fii'). FK única: assetId.

// Ativo PLANEJADO (16/09/2026): o usuário inclui um ativo na aba da carteira
// SEM posição (sem quantidade/valor) só para usar Objetivo / Quanto Falta /
// Necessidade de Aporte no planejamento dos próximos aportes. Fica FORA de
// Portfolio de propósito: TWR, snapshots, proventos, IR e fluxo automático
// nunca enxergam esta tabela. Na 1ª compra do ativo o `objetivo` migra para
// Portfolio.objetivo e a linha é apagada (ver /api/carteira/operacao).
// (Era a "lista de observação", que nunca ganhou tela.)
model Watchlist {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  assetId           String?
  asset             Asset?   @relation(fields: [assetId], references: [id])
  addedAt           DateTime @default(now())
  notes             String? // Observações do usuário
  objetivo          Float    @default(0) // Objetivo percentual dentro da aba
  secao             String? // Seção da aba: estrategia (value/growth/risk), tipoFii, regiaoEtf
  // Aba escolhida pelo usuário quando ≠ aba base (mover na Carteira, out/2026); null = deriva de Asset.type
  categoriaOverride String?

  @@unique([userId, assetId])
  @@index([userId])
  @@map("watchlists")
}

// Portfolio do usuário
model Portfolio {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  assetId           String?
  asset             Asset?              @relation(fields: [assetId], references: [id])
  quantity          Float // Quantidade (Float para suportar criptomoedas com frações, ex: 0.000001 BTC)
  avgPrice          Float // Preço médio de compra
  totalInvested     Float // Total investido
  objetivo          Float               @default(0) // Objetivo percentual do ativo
  estrategia        String? // Estratégia da ação: 'value', 'growth' ou 'risk'
  tipoFii           String? // Tipo do FII: 'fofi', 'tvm' ou 'tijolo'
  regiaoEtf         String? // Região do ETF: 'brasil' ou 'estados_unidos'
  // Aba escolhida pelo usuário quando ≠ aba base (mover na Carteira, out/2026); null = deriva de Asset.type
  categoriaOverride String?
  tipoFundo         String? // Subgrupo escolhido na aba Fundos (FundoSubtipo); null = cadeia atual
  lastUpdate        DateTime            @default(now())
  proventos         PortfolioProvento[]

  // Vínculo com planejamento (mutuamente exclusivos — validado na API):
  // sonho (FK) OU aposentadoria (flag; AposentadoriaPlano é 1 por usuário).
  // Aportes/resgates do ativo alimentam o realizado do plano vinculado e saem
  // das linhas automáticas do fluxo de caixa (evita dupla contagem).
  planejamentoObjetivoId String?
  planejamentoObjetivo   PlanejamentoObjetivo? @relation(fields: [planejamentoObjetivoId], references: [id], onDelete: SetNull)
  vinculoAposentadoria   Boolean               @default(false)

  @@unique([userId, assetId])
  @@index([userId])
  @@index([userId, assetId])
  @@index([userId, planejamentoObjetivoId])
  @@map("portfolios")
}

// Proventos registrados pelo usuário por posição na carteira (edição na tela de ativo)
model PortfolioProvento {
  id                  String    @id @default(uuid())
  portfolioId         String
  portfolio           Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo                String
  dataCom             DateTime
  dataPagamento       DateTime
  precificarPor       String    @default("valor")
  valorTotal          Float
  quantidadeBase      Float
  impostoRenda        Float?
  // Soft delete: usuário deletou explicitamente. Sync respeita — não recria.
  dismissed           Boolean   @default(false)
  // Origem da entry: "brapi" (criada/atualizada pelo sync) ou "manual"
  // (criada/editada pelo usuário via UI). Sync atualiza só rows brapi.
  source              String    @default("manual")
  // Caixa para Investir (fase 3, 21/09/2026): quando o provento pago entrou no
  // caixa livre e quanto (R$, líquido de IR). Marcado uma vez só — nunca credita de novo.
  caixaCreditadoEm    DateTime?
  caixaCreditadoValor Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([portfolioId])
  @@index([userId])
  @@map("portfolio_proventos")
}

// Histórico de transações (compras e vendas)
model StockTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id])
  type      String // "compra" ou "venda"
  quantity  Float // Quantidade (Float para suportar criptomoedas com frações)
  price     Float // Preço por ação
  total     Float // Valor total da transação
  date      DateTime // Data da transação
  fees      Float? // Taxas da operação
  notes     String? // Observações
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, assetId, date])
  @@map("stock_transactions")
}

// ===== EXTERNAL DATA MODELS =====

// Ativos consolidados (ações, FII, ETF, BDR, REIT, criptos, etc.)
model Asset {
  id             String    @id @default(uuid())
  symbol         String    @unique // Código do ativo (ex: PETR4, VALE3, BTC, ETH)
  name           String // Nome do ativo (ex: Petrobras PN, Vale ON, Bitcoin)
  type           String // Tipo: "stock", "etf", "fii", "bdr", "crypto"
  currency       String // Moeda: "BRL", "USD"
  source         String    @default("brapi") // Fonte dos dados
  currentPrice   Decimal?  @db.Decimal(18, 6) // Preço atual; IBOV pode exceder 10^4
  priceUpdatedAt DateTime? // Data da última atualização de preço
  cnpj           String? // CNPJ para fundos — vincula a dados CVM
  categoria      String? // Fundos: Tipo_Classe da CVM (categoria nível 1)
  subcategoria   String? // Fundos: Classificacao da CVM (subcategoria nível 2)
  updatedAt      DateTime  @updatedAt

  // Relacionamentos
  watchlists       Watchlist[]
  portfolios       Portfolio[]
  transactions     StockTransaction[]
  fixedIncomeAsset FixedIncomeAsset?
  priceHistory     AssetPriceHistory[]

  @@index([symbol])
  @@index([type])
  @@index([source])
  @@index([cnpj])
  @@map("assets")
}

// Histórico de preços dos ativos (persistido pelo cron, lido pelas telas)
model AssetPriceHistory {
  id        String   @id @default(uuid())
  assetId   String
  symbol    String
  price     Decimal  @db.Decimal(18, 6) // IBOV e índices podem exceder 10^4
  currency  String?
  source    String   @default("BRAPI")
  date      DateTime // Data de referência (normalizada para início do dia)
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([symbol, date])
  @@index([symbol, date])
  @@index([symbol])
  @@index([date])
  @@map("asset_price_history")
}

// Histórico de proventos/dividendos (banco primeiro, fallback BRAPI com persistência)
model AssetDividendHistory {
  id            String    @id @default(uuid())
  symbol        String
  date          DateTime // Data de pagamento do provento (paymentDate na BRAPI)
  dataCom       DateTime? // Data-com / ex-dividend date — elegibilidade do investidor
  tipo          String // "Dividendo", "JCP", etc.
  valorUnitario Float // Valor por cota/ação
  source        String    @default("BRAPI")
  createdAt     DateTime  @default(now())

  @@unique([symbol, date, tipo])
  @@index([symbol])
  @@index([symbol, date])
  @@index([symbol, dataCom])
  @@map("asset_dividend_history")
}

// Ações corporativas: desdobramento (split), grupamento (inplit), bonificação
model AssetCorporateAction {
  id             String   @id @default(uuid())
  symbol         String
  date           DateTime // Data ex (lastDatePrior) ou data de aprovação
  type           String // "DESDOBRAMENTO" | "GRUPAMENTO" | "BONIFICACAO"
  factor         Float // 2.0 para split 2:1, 0.5 para grupamento 1:2
  completeFactor String? // "2 para 1" (legível)
  isinCode       String?
  source         String   @default("BRAPI")
  createdAt      DateTime @default(now())

  @@unique([symbol, date, type])
  @@index([symbol])
  @@index([symbol, date])
  @@map("asset_corporate_actions")
}

// Fundamentos do ativo (P/L, Beta, Dividend Yield) - banco primeiro, fallback BRAPI
model AssetFundamentals {
  id            String   @id @default(uuid())
  symbol        String   @unique
  priceEarnings Float? // P/L
  beta          Float?
  dividendYield Float? // Em %
  updatedAt     DateTime @updatedAt

  @@map("asset_fundamentals")
}

// Cobertura de dados de mercado por símbolo: registro de status do backfill,
// checkpoint de resumabilidade e fila de gaps de runtime. Permite que o runtime
// leia SÓ do banco (sem fallback externo no request) — quando um símbolo falta,
// registra-se um gap aqui e o backfill background o drena.
model MarketDataCoverage {
  id             String    @id @default(uuid())
  symbol         String    @unique
  // 'OK' (tem dados) | 'EMPTY' (fonte buscada, ativo genuinamente sem provento/evento)
  // | 'FETCH_FAIL' (não conseguiu buscar — retry) | 'GAP_QUEUED' (faltou em runtime)
  status         String
  dividendCount  Int       @default(0)
  caCount        Int       @default(0)
  lastCheckedAt  DateTime? // última vez que o backfill processou o símbolo (cursor/resume)
  gapRequestedAt DateTime? // setado pelo runtime quando o símbolo falta
  lastError      String?
  source         String? // 'backfill' | 'runtime-gap' | 'catalog-hook' | 'add-flow'
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([gapRequestedAt])
  @@index([lastCheckedAt])
  @@map("market_data_coverage")
}

// Log opcional de execução do sync de preços
model SyncPriceLog {
  id            String   @id @default(uuid())
  totalUpdated  Int      @default(0)
  totalInserted Int      @default(0)
  errors        Int      @default(0)
  duration      Int // segundos
  executedAt    DateTime @default(now())

  @@index([executedAt])
  @@map("sync_price_logs")
}

model FixedIncomeAsset {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id])
  assetId         String                @unique
  asset           Asset                 @relation(fields: [assetId], references: [id])
  type            FixedIncomeType
  description     String
  startDate       DateTime
  maturityDate    DateTime
  investedAmount  Float
  annualRate      Float
  indexer         FixedIncomeIndexer?
  indexerPercent  Float?
  liquidityType   FixedIncomeLiquidity?
  taxExempt       Boolean               @default(false)
  tesouroBondType String? // "Tesouro Selic", "Tesouro IPCA+", etc. — vincula a TesouroDiretoPrice
  tesouroMaturity DateTime? // Vencimento do titulo Tesouro — vincula a TesouroDiretoPrice
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([assetId])
  @@map("fixed_income_assets")
}

// Enum para status das instituições
enum InstitutionStatus {
  ATIVA
  INATIVA
}

// Instituições financeiras (corretoras e bancos de investimento)
model Institution {
  id        String            @id @default(cuid())
  codigo    String            @unique // Código identificador da instituição
  nome      String // Nome da instituição
  cnpj      String? // CNPJ da instituição (opcional)
  status    InstitutionStatus @default(ATIVA)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([codigo])
  @@index([cnpj])
  @@index([status])
  @@map("institutions")
}

model ConsultantImpersonationLog {
  id           String   @id @default(uuid())
  consultantId String
  consultant   User     @relation("ImpersonationLogConsultant", fields: [consultantId], references: [id])
  clientId     String
