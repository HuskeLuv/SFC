-[10px] border px-3 py-2.5 border-gray-200 dark:border-gray-800 "><h3 class="m-0 flex items-center gap-2 text-sm font-semibold text-gray-800 dark:text-white/90"><span class="inline-flex items-center " data-estado-criterio="nao_atende"><span aria-hidden="true" class="inline-flex h-[22px] w-[22px] flex-none items-center justify-center rounded-full border-[1.5px] border-gray-700 leading-none text-gray-700 dark:border-gray-300 dark:text-gray-300">—</span><span class="sr-only">não atende:</span></span><span class="min-w-0">FCL crescente</span></h3><div class="inline-flex flex-col gap-1 " data-mini-barras=""><div role="img" tabindex="0" aria-label="FCL crescente, 2020 a 2025: 2020: 3.371; 2021: 92; 2022: 1.809; 2023: 5.363; 2024: 5.402; 2025: 3.760" class="inline-flex rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0079F2] dark:focus-visible:ring-[#6E9DC4]"><svg width="75" height="30" viewBox="0 0 75 30" aria-hidden="true" class="overflow-visible"><rect data-barra="positivo" x="0" y="11.715198074787114" width="10" height="17.784801925212886" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2020: 3.371</title></rect><rect data-barra="positivo" x="13" y="27.5" width="10" height="2" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2021: 92</title></rect><rect data-barra="positivo" x="26" y="19.956034801925213" width="10" height="9.543965198074787" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2022: 1.809</title></rect><rect data-barra="positivo" x="39" y="1.2057571269900045" width="10" height="28.294242873009996" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2023: 5.363</title></rect><rect data-barra="positivo" x="52" y="1" width="10" height="28.5" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2024: 5.402</title></rect><rect data-barra="positivo" x="65" y="9.662902628656052" width="10" height="19.837097371343948" rx="1.5" class="fill-[#396CAA] dark:fill-[#6E9DC4] "><title>2025: 3.760