# ─────────────────────────────────────────────────────────────────────
# Variáveis obrigatórias
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL — connection string completa
# Local: postgresql://user:pass@localhost:5432/sfc?schema=public
# AWS RDS (MVP, sem RDS Proxy): postgresql://user:pass@<rds-endpoint>:5432/myfinance?connection_limit=5&sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Chave de assinatura JWT — gerar com: openssl rand -hex 64
JWT_SECRET="your-jwt-secret-key-here"

# Chave da BRAPI para cotações B3 — pegar em https://brapi.dev
BRAPI_API_KEY="your-brapi-api-key-here"

# Bearer token usado pelos endpoints /api/cron/* — gerar com: openssl rand -hex 32
# O EventBridge Scheduler (ou cron externo) envia este token em Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-cron-secret-here"

# ─────────────────────────────────────────────────────────────────────
# Variáveis opcionais
# ─────────────────────────────────────────────────────────────────────

# TTL (em ms) do cache server-side de /api/carteira/resumo. Default: 30000 (30s)
# CARTEIRA_RESUMO_CACHE_MS=30000

# Se "true", usa snapshots persistidos pra histórico de patrimônio em vez de rebuild ao vivo.
# Default: false (rebuild). Ativar quando snapshots estiverem populados em produção.
# USE_PORTFOLIO_SNAPSHOTS=false

# Kill-switch de cadastro. Se "true", /api/auth/register responde 503 e nenhum
# usuário novo é criado. Lido em runtime — basta alterar e reiniciar o serviço.
# Default: ausente (cadastro liberado).
# REGISTRATION_DISABLED=false

# ─────────────────────────────────────────────────────────────────────
# Cedro Crystal (avaliação de market data — API SOCKET, scripts/cedro/*)
# ─────────────────────────────────────────────────────────────────────
# Conexão TCP/Telnet persistente, porta 81. Usada só por worker/CLI fora do Next.
# CEDRO_HOST=cd102.cedrotech.com
# CEDRO_PORT=81
# CEDRO_USER=
# CEDRO_PASS=
# CEDRO_SOFTWARE_KEY=

# Assistente de IA (Fase 0 — docs/assistente/README.md). Só no servidor, nunca exportar no shell.
# ANTHROPIC_API_KEY="sk-ant-api03-..."      # Console: platform.claude.com (workspace Dev/Prod)
# OPENAI_API_KEY="sk-..."                    # candidato do teste cego (gpt-5.6-luna)
# GOOGLE_API_KEY="AIza..."                   # candidato do teste cego (gemini-3.8-flash)
# ASSISTENTE_CAMBIO_BRL="5.39"               # US$→R$ com IOF, para o custo por mensagem
# ASSISTENTE_HABILITADO="true"               # liga o assistente (botão flutuante + /api/assistente)
# ASSISTENTE_MODELO="claude-haiku-4-5"       # modelo padrão (decisão 10/09/2026)
# ASSISTENTE_LIMITE_MENSAL="300"             # mensagens por usuário/mês
# ASSISTENTE_SECRET="..."                    # assina as propostas de lançamento (fallback: JWT_SECRET)

# ─────────────────────────────────────────────────────────────────────
# Pluggy (integração bancária Open Finance — docs/pluggy-dev-setup.md)
# ─────────────────────────────────────────────────────────────────────
# Tudo opcional e desligado por padrão. Credenciais vêm do dashboard
# (dashboard.pluggy.ai → Applications). Só no servidor, nunca NEXT_PUBLIC.
# PLUGGY_HABILITADO="true"                  # liga webhook, status e hosts na CSP
# PLUGGY_CLIENT_ID=""
# PLUGGY_CLIENT_SECRET=""
# PLUGGY_WEBHOOK_SECRET=""                  # openssl rand -hex 32; mesmo valor no header X-Webhook-Secret do webhook
# PLUGGY_INCLUI_SANDBOX="true"              # lista conectores de sandbox (user-ok / password-ok / MFA 123456) — só dev

# ─────────────────────────────────────────────────────────────────────
# Comunidade (posts, curtidas, comentários — 23/09/2026)
# ─────────────────────────────────────────────────────────────────────
# Desligada por padrão (fica só em dev até o termo ser revisado).
# COMUNIDADE_HABILITADA="true"              # mostra o menu e libera /api/comunidade/**

# ─────────────────────────────────────────────────────────────────────
# Análise de Ativos (Fase 0 = só dados, sem tela — 30/09/2026)
# ─────────────────────────────────────────────────────────────────────
# Desligadas por padrão; ligar só depois da Fase 1. Os jobs /api/cron/analise-ativos/*
# rodam com ou sem a flag (ver docs/analise-ativos/fase0/RUNBOOK.md).
# ANALISE_ATIVOS_HABILITADA=false           # "true" liga a área /analise-ativos (Fase 1) e põe resultados/assembleias na Agenda
# ANALISE_ATIVOS_ACESSO=beta                # "beta" (padrão): só feature_beta_users + admins; "todos" abre para todos
# ANALISE_ATIVOS_NOVO_ATE=2026-12-31        # selo NOVO no menu até esta data (AAAA-MM-DD)
# ANALISE_ATIVOS_ALERTA_ADMIN=false         # "true" (só em produção) manda alerta de job para o sino dos admins
# Bloco 1 (docs/analise-ativos/bloco1-salvos): desligadas por padrão; só valem com a área liberada.
# ANALISE_ATIVOS_SALVOS_HABILITADO=false    # "true" liga Salvos (listas, Salvar, filtros e comparações salvas)
# ANALISE_ATIVOS_ALERTAS_HABILITADO=false   # "true" liga os avisos das listas (exige SALVOS; job alertas-salvos)
# ANALISE_ATIVOS_PDF_HABILITADO=false       # "true" liga o Exportar PDF do Comparador (exige COMPARADOR)

# ─────────────────────────────────────────────────────────────────────
# Assinaturas (Stripe — Basic/Pro/Advanced, ClickUp 86e2zkhe2)
# ─────────────────────────────────────────────────────────────────────
# Desligada por padrão = app como sempre foi (todo usuário Advanced, rotas
# /api/assinaturas/* e /planos 404, sem cadeado, sem limite de conexões e a IA
# com o ASSISTENTE_LIMITE_MENSAL). Ligar exige também STRIPE_SECRET_KEY e
# STRIPE_WEBHOOK_SECRET. Só no servidor, nunca NEXT_PUBLIC. Config em
# src/lib/assinaturasConfig.ts (edge-safe) e SDK em src/lib/stripe.ts (Node).
# ASSINATURAS_HABILITADAS="true"
# STRIPE_SECRET_KEY=""                      # sk_test_… no .env.local; sk_live_… só no app.env
# STRIPE_WEBHOOK_SECRET=""                  # whsec_… do endpoint (no dev, o que o `stripe listen` imprime)
# Prices (Dashboard → Product catalog; mensal e anual no mesmo Product):
# STRIPE_PRICE_PRO_MENSAL=""                # price_…
# STRIPE_PRICE_PRO_ANUAL=""
# STRIPE_PRICE_ADV_MENSAL=""
# STRIPE_PRICE_ADV_ANUAL=""
# Cupons da Black Friday (amount_off BRL, duration once; só no anual). OBRIGATÓRIOS durante a
# oferta: ausente = o anual daquele plano responde 503 até o fim da oferta (as telas anunciam o desconto).
# STRIPE_COUPON_BF_PRO_ANUAL=""
# STRIPE_COUPON_BF_ADV_ANUAL=""
# ASSINATURAS_APP_URL="http://localhost:3000"   # base das URLs de retorno (padrão https://appmyfinance.com.br)
# Migração de usuários (datas ISO):
# ASSINATURAS_CORTESIA_CORTE="2026-11-15T03:00:00Z"  # criado antes = legado Advanced (padrão: este valor)
# ASSINATURAS_CORTESIA_ATE=""               # fim do legado (proposta: ligar + 60 dias); ausente = sem data
# ASSINATURAS_LANCAMENTO_ATE=""             # acesso completo de quem se cadastrou após o corte (ligar + 14 dias); ausente = não há
# ASSINATURAS_CARENCIA_DIAS="7"             # só exibição: "atualize o pagamento até dd/mm"
# Overrides de LIMITES_PLANO (src/lib/planos.ts), só com a chave ligada; a IA fica ≤ ASSISTENTE_LIMITE_MENSAL:
# ASSINATURAS_LIMITE_IA_BASIC="30"
# ASSINATURAS_LIMITE_IA_PRO="100"
# ASSINATURAS_LIMITE_IA_ADV="300"
# ASSINATURAS_LIMITE_CONEXOES_BASIC="1"
# ASSINATURAS_LIMITE_CONEXOES_PRO="3"
# ASSINATURAS_LIMITE_CONEXOES_ADV="6"
# Override de QA dos cadeados (aliases de RELATORIO_PLANO_FORCADO[_PERMITIDO]); NUNCA no app.env:
# PLANO_FORCADO="basic"                     # basic | pro | adv
# PLANO_FORCADO_PERMITIDO="1"
